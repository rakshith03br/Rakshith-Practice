------------------------------------------------------------------
13. POST CONDITIONS REFERENCE
------------------------------------------------------------------

post {
    always   { }  // always runs
    success  { }  // build succeeded
    failure  { }  // build failed
    unstable { }  // build unstable (e.g. test failures)
    changed  { }  // status changed vs previous run
    fixed    { }  // build fixed after a previous failure
    regression { } // build got worse than previous run
    aborted  { }  // build was aborted
    cleanup  { }  // runs after all other post conditions
}

------------------------------------------------------------------
14. USEFUL PIPELINE STEPS (QUICK LIST)
------------------------------------------------------------------

sh 'command'                     // run shell command (Linux/macOS)
bat 'command'                    // run batch command (Windows)
powershell 'command'             // run PowerShell
echo 'message'                   // print to console log
error 'message'                  // fail the build with a message
sleep time: 5, unit: 'SECONDS'   // pause execution
archiveArtifacts artifacts: '**/*.jar', fingerprint: true
stash name: 'build-output', includes: '**/*'
unstash 'build-output'
deleteDir()                      // delete current directory
cleanWs()                        // clean workspace (requires plugin)
currentBuild.result = 'SUCCESS'  // set build result manually
currentBuild.displayName = "Build #${env.BUILD_NUMBER} - custom"
milestone label: 'my-milestone'  // ensure ordering across concurrent builds
lock('resource-name') { }        // limit concurrent access to a resource

------------------------------------------------------------------
15. TIPS
------------------------------------------------------------------

- Use Declarative for most day-to-day pipelines: better structure,
  validation, and readability.
- Drop into script { ... } blocks inside Declarative when you need
  loops, custom functions, or complex conditionals.
- Use Scripted pipelines when you need maximum flexibility (dynamic
  stage generation, complex control flow) that Declarative can't
  easily express.
- Keep shared/reusable logic in a Jenkins Shared Library rather than
  duplicating Groovy code across Jenkinsfiles.
- Use the "Pipeline Syntax" generator in the Jenkins UI (under a
  pipeline job) to auto-generate correct step syntax for plugins.
- Validate Jenkinsfile syntax before committing using the Jenkins
  CLI: java -jar jenkins-cli.jar declarative-linter < Jenkinsfile

