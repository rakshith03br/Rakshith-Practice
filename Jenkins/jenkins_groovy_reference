==================================================================
JENKINS GROOVY (JENKINS FILE) SYNTAX REFERENCE
==================================================================

There are two pipeline styles in Jenkins:
  1. DECLARATIVE PIPELINE - structured, opinionated, easier to read
  2. SCRIPTED PIPELINE    - plain Groovy, more flexible/powerful

------------------------------------------------------------------
1. DECLARATIVE PIPELINE - FULL SKELETON
------------------------------------------------------------------

pipeline {
    agent any   // or: agent { label 'linux' }
                // or: agent { docker { image 'node:18' } }
                // or: agent none  (define per-stage agents instead)

    environment {
        APP_ENV = 'production'
        CREDS   = credentials('my-cred-id')
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Branch to build')
        booleanParam(name: 'DEPLOY', defaultValue: false, description: 'Deploy after build?')
        choice(name: 'ENV', choices: ['dev', 'staging', 'prod'], description: 'Target env')
        text(name: 'NOTES', defaultValue: '', description: 'Free text notes')
        password(name: 'SECRET', defaultValue: '', description: 'Sensitive value')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        retry(2)
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
    }

    triggers {
        cron('H 2 * * *')       // scheduled build (H spreads load)
        pollSCM('H/5 * * * *')  // poll SCM every ~5 min
        upstream(upstreamProjects: 'other-job', threshold: hudson.model.Result.SUCCESS)
    }

    tools {
        maven 'Maven-3.9'
        jdk 'JDK-17'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Deploy') {
            when {
                expression { params.DEPLOY == true }
            }
            steps {
                echo "Deploying to ${params.ENV}"
            }
        }
    }

    post {
        success {
            echo 'Build succeeded!'
        }
        failure {
            mail to: 'team@example.com', subject: 'Build Failed', body: 'Check Jenkins'
        }
        unstable {
            echo 'Build unstable'
        }
        changed {
            echo 'Result changed from previous run'
        }
        always {
            cleanWs()
        }
    }
}

------------------------------------------------------------------
2. SCRIPTED PIPELINE - FULL SKELETON
------------------------------------------------------------------

node('linux') {
    try {
        stage('Checkout') {
            checkout scm
        }

        stage('Build') {
            sh 'mvn clean package'
        }

        stage('Test') {
            sh 'mvn test'
        }

        if (env.BRANCH_NAME == 'main') {
            stage('Deploy') {
                sh './deploy.sh'
            }
        }
    } catch (Exception e) {
        currentBuild.result = 'FAILURE'
        throw e
    } finally {
        cleanWs()
    }
}

------------------------------------------------------------------
3. VARIABLES & ENVIRONMENT
------------------------------------------------------------------

def myVar = "hello"
echo "${myVar} world"
echo "Build number: ${env.BUILD_NUMBER}"
echo "Job name: ${env.JOB_NAME}"
echo "Workspace: ${env.WORKSPACE}"
echo "Git branch: ${env.BRANCH_NAME}"
echo "Build URL: ${env.BUILD_URL}"

Set an env var dynamically inside a script block:
    script {
        env.MY_VAR = "some-value"
    }

------------------------------------------------------------------
4. CONDITIONALS (when block - Declarative)
------------------------------------------------------------------

when {
    branch 'main'
}

when {
    allOf {
        branch 'main'
        environment name: 'DEPLOY', value: 'true'
    }
}

when {
    anyOf {
        branch 'main'
        branch 'release/*'
    }
}

when {
    not { branch 'main' }
}

when {
    expression { return params.DEPLOY == true }
}

when {
    changelog '.*BUILD.*'
}

when {
    changeset "**/*.java"
}

Groovy-style if/else (inside script {} blocks):
    script {
        if (env.BRANCH_NAME == 'main') {
            echo 'On main branch'
        } else if (env.BRANCH_NAME.startsWith('release/')) {
            echo 'On a release branch'
        } else {
            echo 'Other branch'
        }
    }

------------------------------------------------------------------
5. PARALLEL STAGES
------------------------------------------------------------------

stage('Parallel Tests') {
    parallel {
        stage('Unit') {
            steps { sh 'run-unit-tests.sh' }
        }
        stage('Integration') {
            steps { sh 'run-integration-tests.sh' }
        }
    }
}

Scripted style parallel:
    parallel(
        unit: {
            sh 'run-unit-tests.sh'
        },
        integration: {
            sh 'run-integration-tests.sh'
        }
    )

------------------------------------------------------------------
6. FUNCTIONS / SHARED LOGIC
------------------------------------------------------------------

def buildApp(String env) {
    sh "mvn clean package -Denv=${env}"
}

pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                script {
                    buildApp('staging')
                }
            }
        }
    }
}

------------------------------------------------------------------
7. LOOPS & COLLECTIONS
------------------------------------------------------------------

script {
    for (int i = 0; i < 3; i++) {
        echo "Iteration ${i}"
    }

    def services = ['auth', 'api', 'web']
    services.each { svc ->
        echo "Deploying ${svc}"
    }

    def map = [name: 'app', version: '1.0']
    map.each { key, value ->
        echo "${key} = ${value}"
    }
}

------------------------------------------------------------------
8. READING FILES / JSON / PROPERTIES
------------------------------------------------------------------

script {
    def config = readJSON file: 'config.json'
    echo "Version: ${config.version}"

    def props = readProperties file: 'build.properties'
    echo "${props['some.key']}"

    def yamlData = readYaml file: 'values.yaml'

    def fileContents = readFile 'somefile.txt'
    writeFile file: 'output.txt', text: 'Hello World'
}

------------------------------------------------------------------
9. CREDENTIALS
------------------------------------------------------------------

withCredentials([usernamePassword(
        credentialsId: 'my-cred',
        usernameVariable: 'USER',
        passwordVariable: 'PASS')]) {
    sh 'curl -u $USER:$PASS https://api.example.com'
}

withCredentials([string(credentialsId: 'api-token', variable: 'TOKEN')]) {
    sh 'curl -H "Authorization: Bearer $TOKEN" https://api.example.com'
}

withCredentials([sshUserPrivateKey(
        credentialsId: 'ssh-key',
        keyFileVariable: 'SSH_KEY')]) {
    sh 'ssh -i $SSH_KEY user@host "echo hello"'
}

------------------------------------------------------------------
10. INPUT STEP (MANUAL APPROVAL)
------------------------------------------------------------------

stage('Approval') {
    steps {
        input message: 'Deploy to production?', ok: 'Deploy'
    }
}

With a timeout and submitter restriction:
stage('Approval') {
    steps {
        timeout(time: 15, unit: 'MINUTES') {
            input message: 'Approve deploy?', ok: 'Yes', submitter: 'admin,release-manager'
        }
    }
}

